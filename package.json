{
  "name": "ftcli",
  "version": "0.1.0",
  "description": "FTP list / diff / upload / download / backup CLI",
  "license": "MIT",
  "keywords": ["ftp", "cli", "diff", "upload", "download", "backup", "deploy"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R00neyj/ftcli.git"
  },
  "homepage": "https://github.com/R00neyj/ftcli#readme",
